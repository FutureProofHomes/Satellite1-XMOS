# Local XMOS toolchain install root.
XMOS_XTC_ROOT=$HOME/Projects/FutureProofHomes/XMOS_XTC_15.3.1

# Optional default xTAG adapter ids per board.
# SQ66_XTAG_ID=7A3VAER2
# SAT1_XTAG_ID=W256H8UD
# XMOS_ADAPTER_ID=7A3VAER2  # backward-compatible fallback

SQ66_RPI_HOST=rasp0core1
SAT1_RPI_HOST=rasp0core2

# Optional remote CLI command paths for HIL/tests/tools.
SAT1_RPI_CLI_CMD=sat1
SQ66_RPI_CLI_CMD="/home/pi/.cache/satellite1-rpi-e2e/sat1_or_python.sh"
